# =============================================================================
# Multi-Org Chatbot Environment Configuration
# =============================================================================
# Copy this file to .env and update the values according to your setup
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MySQL Database URL for user management and chat history
# Format: mysql+pymysql://username:password@host:port/database_name
DATABASE_URL=mysql+pymysql://root:12345678@127.0.0.1:3306/chatbot_rag

# Alternative database URL key (for compatibility)
SQLALCHEMY_DATABASE_URL=mysql+pymysql://root:12345678@127.0.0.1:3306/chatbot_rag

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Secret key for JWT token signing (use a strong secret in production)
SECRET_KEY=your-super-secret-jwt-key-here-change-this-in-production
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production

# JWT algorithm and expiration settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# SUPER ADMIN CONFIGURATION
# =============================================================================
# Super admin credentials for initial setup
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=admin123

# =============================================================================
# AI/LLM CONFIGURATION
# =============================================================================
# OpenAI API Key for chat completions
OPENAI_API_KEY=your-openai-api-key-here



# LLM Model for chat responses
LLM_MODEL=llama3.1:8b-instruct-q4_K_M

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================
# Ollama server URL and model for graph processing
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_API_KEY=ollama

# =============================================================================
# EMBEDDING MODEL CONFIGURATION
# =============================================================================
# Sentence transformer model for embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector database persistence directory
PERSIST_DIR=./chroma_db

# =============================================================================
# GRAPH DATABASE CONFIGURATION
# =============================================================================
# Graph output directory for visualizations
GRAPH_OUTPUT_DIR=./graph_output
GRAPH_CACHE_DIR=./graph_cache

# Graph processing settings
MAX_CHUNKS_PER_BATCH=1000
SIMILARITY_THRESHOLD=0.7
MAX_SIMILAR_CHUNKS=5




# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Graph MCP URL for external graph services
GRAPH_MCP_URL=http://127.0.0.1:5001

# Enable automatic graph updates
ENABLE_GRAPH_AUTO_UPDATE=true

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# API base URL for frontend connections
API_BASE_URL=http://127.0.0.1:8000

# Alternative API base URL key (for compatibility)
API_BASE=http://127.0.0.1:8000

# Organization ID for multi-org setup
ORG_ID=demo-org

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to 'development' for debug mode, 'production' for production
ENVIRONMENT=development

# Enable debug logging
DEBUG=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CORS origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting settings
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# =============================================================================
# BACKUP AND MAINTENANCE
# =============================================================================
# Enable automatic backups
ENABLE_AUTO_BACKUP=false

# Backup directory
BACKUP_DIR=./backups

# Backup retention days
BACKUP_RETENTION_DAYS=30
